# Server Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ─── MongoDB ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ecommerce?retryWrites=true&w=majority

# ─── JWT Secrets (use long random strings) ────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# ─── Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Gmail SMTP (Nodemailer) ──────────────────────────────
# Enable "Less secure app access" OR use an App Password
# Guide: https://myaccount.google.com/apppasswords
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ─── App Config ───────────────────────────────────────────
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development
